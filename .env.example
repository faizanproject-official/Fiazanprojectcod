# ============================================
# COD Realistic - Shopify App - Environment
# ============================================

# Shopify app credentials (Shopify Partners -> your app -> Client credentials)
SHOPIFY_API_KEY=your_api_key_here
SHOPIFY_API_SECRET=your_api_secret_here

# Public HTTPS URL of this app (Railway gives you one, e.g. https://xxx.up.railway.app)
# No trailing slash!
SHOPIFY_APP_URL=https://your-app.up.railway.app

# Scopes the app needs
SCOPES=write_draft_orders,read_draft_orders,read_orders,read_products,write_script_tags,read_script_tags

# Railway PostgreSQL (add Postgres service in Railway and reference its DATABASE_URL variable)
# Example: postgresql://postgres:password@postgres-xyz.railway.internal:5432/railway
DATABASE_URL=

# Server port (Railway injects this automatically)
PORT=3000
